  presets: [require("nativewind/preset")],
  theme: {
    extend: {
      colors: {
        primary: '#030213',
        secondary: '#6B4F3E',
        background: '#fdfcfb',
        foreground: '#1C0F0A',
        muted: '#9B7B6A',
        destructive: '#d4183d',
      },
    },
  },
  plugins: [],
};
2. babel.config.js (Root directory)
module.exports = function (api) {
  api.cache(true);
  return {
    presets: [
      ["babel-preset-expo", { jsxImportSource: "nativewind" }],
      "nativewind/babel",
    ],
    plugins: [
      'react-native-reanimated/plugin', // Must be last
    ],
  };
};
3. metro.config.js (Root directory)
const { getDefaultConfig } = require("expo/metro-config");
